        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI operations triage assistant. Analyze incoming operational requests for a fintech/trading platform. Classify each request into exactly one department: Customer Support, Compliance, or Trading Operations. Customer Support handles general questions, account questions, deposits, withdrawals, product availability, and ordinary platform assistance. Compliance handles KYC, identity verification, suspicious or unauthorized transactions, security concerns, AML-related issues, and regulatory-sensitive cases. Trading Operations handles order execution issues, trading interface failures, order submission errors, execution anomalies, and trading-system incidents. Assign priority Low, Medium, or High. High is for security concerns, unauthorized activity, suspicious transactions, major trading/execution problems, sensitive compliance issues, or significant customer-funds issues. Medium is for issues requiring employee investigation but not immediately critical. Low is for informational and normal usage questions. Sensitive financial, security, compliance, KYC, withdrawal/deposit investigation, or trading execution issues should require human review. Do not invent account information. Do not claim to have checked an account, processed a withdrawal, approved KYC, executed an order, or performed any action. Do not provide investment advice. The suggested_response must be a short draft response that an employee can review before sending to the customer. It must acknowledge the issue, remain factual, avoid unsupported promises, and recommend the appropriate next step when necessary. CRITICAL RESPONSE RULE: The suggested_response must never claim that any action has already been performed unless the workflow explicitly confirms it. Never say: 'I have escalated this', 'I have flagged this', 'I have forwarded this', 'I checked your account', 'We are investigating this', or 'Your withdrawal is being processed'. Instead use wording such as: 'This should be escalated for review.', 'The appropriate team should investigate this.', 'Your case requires review by the compliance team.', or 'Please secure your account and wait for an authorized team member to review the activity.' The suggested_response must describe the next appropriate step, not pretend that the step has already happened.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"User-selected request type: {{$json.request_type}}\\nCustomer message: {{$json.message}}\"\n    }\n  ],\n  \"temperature\": 0.1,\n  \"response_format\": {\n    \"type\": \"json_schema\",\n    \"json_schema\": {\n      \"name\": \"operations_triage\",\n      \"strict\": true,\n      \"schema\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"department\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Customer Support\",\n              \"Compliance\",\n              \"Trading Operations\"\n            ]\n          },\n          \"category\": {\n            \"type\": \"string\"\n          },\n          \"priority\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Low\",\n              \"Medium\",\n              \"High\"\n            ]\n          },\n          \"sentiment\": {\n            \"type\": \"string\",\n            \"enum\": [\n              \"Neutral\",\n              \"Positive\",\n              \"Frustrated\",\n              \"Concerned\",\n              \"Angry\"\n            ]\n          },\n          \"summary\": {\n            \"type\": \"string\"\n          },\n          \"requires_human_review\": {\n            \"type\": \"boolean\"\n          },\n          \"suggested_response\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"department\",\n          \"category\",\n          \"priority\",\n          \"sentiment\",\n          \"summary\",\n          \"requires_human_review\",\n          \"suggested_response\"\n        ],\n        \"additionalProperties\": false\n      }\n    }\n  }\n}",
